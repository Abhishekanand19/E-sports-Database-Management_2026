# Copy to .env.local. Use a private, randomly generated password.
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
DATABASE_URL=postgresql://esports:REPLACE_WITH_PRIVATE_PASSWORD@127.0.0.1:5432/esports_db
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
# For HTTPS production deployments, APP_ORIGIN must be the public https:// origin.
# Bootstrap credentials belong in environment variables, never committed files.
