{
  "name": "esports-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db.ts",
    "db:seed": "tsx scripts/db.ts --seed",
    "user:create": "tsx scripts/create-user.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "test:api": "tsx --test tests/api.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^15.5.28",
    "pg": "^8.13.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^4.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
